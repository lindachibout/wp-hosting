# WordPress core + plugins/thèmes composer-managed (reconstruits à l'image
# Docker, cf. composer.json "wordpress-install-dir": "wordpress") — seuls
# wordpress/wp-content/db.php et mu-plugins/ sont notre code.
/vendor/

/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/db.php
!/wordpress/wp-content/mu-plugins/

.env
